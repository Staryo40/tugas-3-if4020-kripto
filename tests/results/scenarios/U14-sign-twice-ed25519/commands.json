[
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "../../../keys/ed25519.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign-1",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/ed25519.key.pem",
      "--out",
      "input/bundle-1.json"
    ]
  },
  {
    "label": "sign-2",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/ed25519.key.pem",
      "--out",
      "input/bundle-2.json"
    ]
  },
  {
    "label": "verify-1",
    "command": [
      "tacstmu",
      "verify",
      "--file",
      "input/contoh-app.txt",
      "--bundle",
      "input/bundle-1.json",
      "--trust-store",
      "input/trust.json",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--json"
    ]
  },
  {
    "label": "verify-2",
    "command": [
      "tacstmu",
      "verify",
      "--file",
      "input/contoh-app.txt",
      "--bundle",
      "input/bundle-2.json",
      "--trust-store",
      "input/trust.json",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--json"
    ]
  }
]
