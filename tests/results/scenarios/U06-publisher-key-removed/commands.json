[
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "../../../keys/ed25519.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/ed25519.key.pem",
      "--out",
      "input/bundle.json"
    ]
  },
  {
    "label": "trust-remove",
    "command": [
      "tacstmu",
      "trust",
      "remove",
      "--keyid",
      "c029f9b4967f6efee395c90af71babfe3fb857c041db35d1de0d1363900138dd",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "verify",
    "command": [
      "tacstmu",
      "verify",
      "--file",
      "input/contoh-app.txt",
      "--bundle",
      "input/bundle.json",
      "--trust-store",
      "input/trust.json",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--json"
    ]
  }
]
