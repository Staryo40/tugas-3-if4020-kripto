[
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "../../../keys/ecdsa-p256-sha256.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.bin",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/ecdsa-p256-sha256.key.pem",
      "--out",
      "input/bundle.json"
    ]
  },
  {
    "label": "verify",
    "command": [
      "tacstmu",
      "verify",
      "--file",
      "input/contoh-app.bin",
      "--bundle",
      "input/bundle.json",
      "--trust-store",
      "input/trust.json",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--json"
    ]
  }
]
