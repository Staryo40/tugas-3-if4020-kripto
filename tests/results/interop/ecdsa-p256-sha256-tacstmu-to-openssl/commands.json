[
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "../../../keys/ecdsa-p256-sha256.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/ecdsa-p256-sha256.key.pem",
      "--out",
      "input/bundle.json"
    ]
  },
  {
    "label": "openssl-verify",
    "command": [
      "openssl",
      "dgst",
      "-sha256",
      "-verify",
      "../../../keys/ecdsa-p256-sha256.pub.pem",
      "-signature",
      "input/signature.der",
      "input/manifest.bin"
    ]
  },
  {
    "label": "openssl-verify-tampered",
    "command": [
      "openssl",
      "dgst",
      "-sha256",
      "-verify",
      "../../../keys/ecdsa-p256-sha256.pub.pem",
      "-signature",
      "input/signature.der",
      "input/manifest-tampered.bin"
    ]
  }
]
