[
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "../../../keys/rsa-pss-sha256.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "../../../keys/rsa-pss-sha256.key.pem",
      "--out",
      "input/bundle.json"
    ]
  },
  {
    "label": "openssl-verify",
    "command": [
      "openssl",
      "pkeyutl",
      "-verify",
      "-pubin",
      "-inkey",
      "../../../keys/rsa-pss-sha256.pub.pem",
      "-rawin",
      "-digest",
      "sha256",
      "-pkeyopt",
      "rsa_padding_mode:pss",
      "-pkeyopt",
      "rsa_pss_saltlen:32",
      "-pkeyopt",
      "rsa_mgf1_md:sha256",
      "-in",
      "input/manifest.bin",
      "-sigfile",
      "input/signature.bin"
    ]
  },
  {
    "label": "openssl-verify-tampered",
    "command": [
      "openssl",
      "pkeyutl",
      "-verify",
      "-pubin",
      "-inkey",
      "../../../keys/rsa-pss-sha256.pub.pem",
      "-rawin",
      "-digest",
      "sha256",
      "-pkeyopt",
      "rsa_padding_mode:pss",
      "-pkeyopt",
      "rsa_pss_saltlen:32",
      "-pkeyopt",
      "rsa_mgf1_md:sha256",
      "-in",
      "input/manifest-tampered.bin",
      "-sigfile",
      "input/signature.bin"
    ]
  }
]
