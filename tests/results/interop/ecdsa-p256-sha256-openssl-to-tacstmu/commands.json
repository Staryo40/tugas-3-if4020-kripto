[
  {
    "label": "openssl-genpkey",
    "command": [
      "openssl",
      "genpkey",
      "-algorithm",
      "EC",
      "-pkeyopt",
      "ec_paramgen_curve:P-256",
      "-pkeyopt",
      "ec_param_enc:named_curve",
      "-out",
      "/tmp/tacstmu-interop-79s8xtv0/ecdsa-p256-sha256.key.pem"
    ]
  },
  {
    "label": "openssl-pubout",
    "command": [
      "openssl",
      "pkey",
      "-in",
      "/tmp/tacstmu-interop-79s8xtv0/ecdsa-p256-sha256.key.pem",
      "-pubout",
      "-out",
      "input/openssl.pub.pem"
    ]
  },
  {
    "label": "trust-add",
    "command": [
      "tacstmu",
      "trust",
      "add",
      "--key",
      "input/openssl.pub.pem",
      "--package",
      "contoh-app",
      "--store",
      "input/trust.json"
    ]
  },
  {
    "label": "sign",
    "command": [
      "tacstmu",
      "sign",
      "--file",
      "input/contoh-app.txt",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--key",
      "/tmp/tacstmu-interop-79s8xtv0/ecdsa-p256-sha256.key.pem",
      "--out",
      "input/bundle.json"
    ]
  },
  {
    "label": "openssl-sign",
    "command": [
      "openssl",
      "dgst",
      "-sha256",
      "-sign",
      "/tmp/tacstmu-interop-79s8xtv0/ecdsa-p256-sha256.key.pem",
      "-out",
      "input/openssl-signature.der",
      "input/manifest.bin"
    ]
  },
  {
    "label": "verify",
    "command": [
      "tacstmu",
      "verify",
      "--file",
      "input/contoh-app.txt",
      "--bundle",
      "input/bundle.json",
      "--trust-store",
      "input/trust.json",
      "--package",
      "contoh-app",
      "--version",
      "1.0.0",
      "--json"
    ]
  }
]
